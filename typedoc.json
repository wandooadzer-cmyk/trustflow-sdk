{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/hooks/index.ts",
    "src/escrow/index.ts",
    "src/wallet/index.ts",
    "src/utils/index.ts",
    "src/testing/index.ts"
  ],
  "out": "docs/reference",
  "tsconfig": "./tsconfig.json",
  "name": "TrustFlow SDK",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "exclude": [
    "**/*.test.ts",
    "examples/**",
    "tests/**"
  ],
  "sort": [
    "source-order"
  ],
  "cleanOutputDir": true,
  "skipErrorChecking": true
}
